#!/usr/bin/env bash
#
# This script was automatically generated by `trmnlp init` but it's yours to modify!
# Use this opportunity to set up environment variables, install dependencies, etc.
#
# It runs the trmnlp gem when one is installed, and the Docker image otherwise.
# TRMNLP_DOCKER=1 runs the Docker image even with the gem installed, which gives `trmnlp test`
# the same fonts as CI:
#
#   TRMNLP_DOCKER=1 bin/trmnlp test

# The Docker image to run. Add a tag to stay on one release: trmnl/trmnlp:v0.20.0
IMAGE=trmnl/trmnlp

# Saved on the PATH as `trmnlp`, this script is what `command -v trmnlp` finds: not a gem.
GEM="$(command -v trmnlp)"
if [ -z "$TRMNLP_DOCKER" ] && [ -n "$GEM" ] && ! [ "$GEM" -ef "$0" ]
then
    exec "$GEM" "$@"
fi

if ! command -v docker &> /dev/null
then
    echo "Install the trmnl_preview gem:

  gem install trmnl_preview

Or install Docker:

    https://docs.docker.com/get-docker/"
    exit 1
fi

# Determine XDG config directory on host OS
if [ -n "$XDG_CONFIG_HOME" ]; then
    CONFIG_DIR="$XDG_CONFIG_HOME/trmnlp"
else
    CONFIG_DIR="$HOME/.config/trmnlp"
fi

if [ ! -d "$CONFIG_DIR" ]; then
    mkdir -p "$CONFIG_DIR"
fi

# Look for a newer image once a day. Offline, the image already here is run.
PULLED="$CONFIG_DIR/.image-pulled"
if [ -z "$(find "$PULLED" -mmin -1440 2> /dev/null)" ]
then
    docker pull "$IMAGE" >&2 && touch "$PULLED"
fi

# On Linux the container's root is the host's root, and the files trmnlp writes (snapshots, _build,
# a pulled plugin) would be root's. So trmnlp runs as you, with a home of its own to write in.
# Docker Desktop and rootless Docker hand the files to you already.
CONTAINER_HOME=/root
SECURITY="$(docker info --format '{{.SecurityOptions}}' 2> /dev/null)"
if [ "$(uname)" = Linux ] && [ "$(id -u)" != 0 ] && [ -n "$SECURITY" ] && [[ "$SECURITY" != *rootless* ]]
then
    CONTAINER_HOME=/tmp/home
    # .config is made for you as well: Docker would make it root's to mount the folder below into
    # it, and Firefox hangs when it cannot write there.
    ARGS=(
        --user "$(id -u):$(id -g)"
        --env HOME=/tmp/home
        --tmpfs "/tmp/home:exec,uid=$(id -u),gid=$(id -g)"
        --tmpfs "/tmp/home/.config:uid=$(id -u),gid=$(id -g)"
    )
fi

# A terminal only when there is one: CI and scripts have none.
if [ -t 0 ] && [ -t 1 ]; then
    ARGS+=(--tty)
fi

# Only serve listens, so every other command can run next to it.
if [ "$1" = serve ]; then
    ARGS+=(--publish 4567:4567)
fi

# The whole Git repository is mounted when the plugin is a folder inside one, so its tests can read
# the files next to it.
ROOT_DIR="$(git rev-parse --show-toplevel 2> /dev/null || pwd)"
SUB_DIR="$(git rev-parse --show-prefix 2> /dev/null)"

exec docker run \
    --rm \
    --init \
    --interactive \
    "${ARGS[@]}" \
    --env CI \
    --env TRMNL_API_KEY \
    --volume "$CONFIG_DIR:$CONTAINER_HOME/.config/trmnlp" \
    --volume "$ROOT_DIR:/plugin" \
    --workdir "/plugin/$SUB_DIR" \
    "$IMAGE" "$@"
